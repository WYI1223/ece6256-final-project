# ConFormBench local config template.
# Copy to pilot_B/conformbench/.env and fill in OPENAI_API_KEY. Never commit .env (ignored by the root .gitignore).
LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# deepseek-flash (V4.1-Flash, cheap) or deepseek-v4-pro (stronger, ~3x price)
OPENAI_MODEL=deepseek-flash
# absolute path to the extracted Zenodo package (contains schema/ items/ reports/ splits/)
CONFORMBENCH_DATA_DIR=/absolute/path/to/pilot_B/data_zenodo/conformbench-data-v1.0.0
CONFORMBENCH_TRACE_MESSAGES=1
CONFORMBENCH_TRACK_LLM_COSTS=true
